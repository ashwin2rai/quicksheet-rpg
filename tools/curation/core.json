        "evasion": 10,
        "stressSlots": 3,
        "attackRange": "Melee",
        "damageDie": 6,
        "experienceCount": 2,
        "experienceModifier": 2,
        "source": "Evasion 10, Melee d6 attack, physical-or-magic choice and two +2 Experiences (with the example list): SRD 2.0 'Ranger Companion' section. Starting Stress slots (3): the official Ranger Companion character sheet as transcribed by Old Gus; not stated in the SRD 2.0 text (RD-029).",
        "exampleExperiences": [
          "Bold Distraction",
          "Expert Climber",
          "Fetch",
          "Friendly",
          "Guardian of the Forest",
          "Horrifying",
          "Intimidating",
          "Loyal Until the End",
          "Navigation",
          "Nimble",
          "Nobody Left Behind",
          "On High Alert",
          "Protective",
          "Royal Companion",
          "Scout",
          "Service Animal",
          "Trusted Mount",
          "Vigilant",
          "We Always Find Them",
          "You Can't Hit What You Can't Find"
        ],
        "advancements": [
          {
            "id": "intelligent",
            "label": "Intelligent",
            "slots": 3,
            "text": "Your companion gains a permanent +1 bonus to a Companion Experience of your choice."
          },
          {
            "id": "light-in-the-dark",
            "label": "Light in the Dark",
            "slots": 1,
            "text": "Use this as an additional Hope slot your character can mark."
          },
          {
            "id": "creature-comfort",
            "label": "Creature Comfort",
            "slots": 1,
            "text": "Once per rest, when you take time during a quiet moment to give your companion love and attention, you can gain a Hope or you can both clear a Stress."
          },
          {
            "id": "armored",
            "label": "Armored",
            "slots": 1,
            "text": "When your companion takes damage, you can mark one of your Armor Slots instead of marking one of their Stress."
          },
          {
            "id": "vicious",
            "label": "Vicious",
            "slots": 3,
            "text": "Increase your companion's damage dice or range by one step (d6 to d8, Close to Far, etc.)."
          },
          {
            "id": "resilient",
            "label": "Resilient",
            "slots": 3,
            "text": "Your companion gains an additional Stress slot."
          },
          {
            "id": "bonded",
            "label": "Bonded",
            "slots": 1,
            "text": "When you mark your last Hit Point, your companion rushes to your side to comfort you. Roll a number of d6s equal to the unmarked Stress slots they have and mark them. If any roll a 6, your companion helps you up. Clear your last Hit Point and return to the scene."
          },
          {
            "id": "aware",
            "label": "Aware",
            "slots": 3,
            "text": "Your companion gains a permanent +2 bonus to their Evasion."
          }
        ],
        "advancementSource": "Option text: SRD 2.0 'Leveling Up Your Companion'. Slot counts: official Ranger Companion sheet as transcribed by Old Gus (not stated in the SRD text). Old Gus gives Aware as +1 Evasion; the official SRD says +2, which is used.",
