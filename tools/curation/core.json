  "officialOverrides": {
    "$comment": "Where Old Gus differs from the official SRD 2.0 PDF (DH_SRD_2_2026_08_25.pdf), the official wording wins. Found by cross-checking all imported Level 1 text; see docs/rules-decisions.md RD-025.",
    "features": {
      "feature.rogue.cloaked": {
        "text": "Any time you would be *Hidden*, you are instead *Cloaked*. In addition to the benefits of the *Hidden* condition, while *Cloaked* you remain unseen if you are stationary when an adversary moves to where they would normally see you. After you make an attack or end a move within line of sight of an adversary, you are no longer *Cloaked*.",
        "reason": "Old Gus appends 'Otherwise, this bonus lasts until your next rest.', which is not in the official text (it belongs to Rogue's Dodge)."
      },
      "feature.beastbound.companion": {
        "text": "You have an animal companion of your choice (at the GM's discretion). They stay by your side unless you tell them otherwise.\n\nTake the Ranger Companion sheet. When you level up your character, choose a level-up option for your companion from this sheet as well.",
        "reason": "Old Gus paraphrases the second sentence."
      }
    },
    "classItems": {
      "class.wizard": {
        "items": [
          "a book you're trying to translate",
          "a tiny, harmless elemental pet"
        ],
        "reason": "Old Gus omits 'pet'."
      },
      "class.warrior": {
        "items": [
          "the drawing of a lover",
          "a sharpening stone"
        ],
        "reason": "Official text reads 'The drawing of a lover'."
      }
    }
  },
